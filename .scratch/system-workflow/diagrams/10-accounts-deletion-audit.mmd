flowchart LR
    users(["Admin เปิด Users"])
    create["สร้างบัญชีและแสดง temporary password"]
    password["ผู้ใช้ local ต้องเปลี่ยนรหัส"]
    mutate["เปลี่ยนอีเมล role หรือ enabled"]
    guard["ตรวจ Admin คนสุดท้ายและ concurrent change"]
    revoke["เพิกถอน sessions ตามการเปลี่ยน"]
    reset["Reset password"]
    erase["ลบบัญชี"]
    clean{"ไม่มี Response และ cleanup ค้าง"}
    denied["หยุดและให้ลบข้อมูลก่อน"]
    account["ลบบัญชีและข้อมูลเชื่อมที่เกี่ยวข้อง"]
    response["Admin ยืนยันลบ Response หรือเจ้าของทิ้ง Draft"]
    selected["Admin เลือกและยืนยันลบ Submission ในประวัติรายฟอร์ม"]
    check{"เจ้าของทิ้ง Draft ที่เคยมี Submission หรือไม่"}
    intents["snapshot ทุก revision/workspace/Operation; owner-bound case และ intents"]
    delete["version fence; retire เฉพาะ refs ของ Response; cascade rows"]
    files["initial ECM DELETE เฉพาะ owned file ที่ไร้ surviving refs"]
    retry["file cleanup pending: URL อาจยังเปิดได้; ห้าม blind resend"]
    tombstone["durable tombstone/case อยู่รอดหลัง restart"]
    audit["เก็บ AuditEvent ที่ไม่มี credential"]
    view["/admin/audit อ่านและกรอง"]
    users --> create --> password
    users --> mutate --> guard --> revoke
    users --> reset --> revoke
    users --> erase --> clean
    clean -->|"ไม่ผ่าน"| denied
    clean -->|"ผ่าน"| account
    selected --> scopeSubmission{"ยังมี Submission อื่นและไม่มีงานที่ขวางการลบหรือไม่"}
    scopeSubmission -->|"ไม่"| keepSubmission["ปฏิเสธและคงข้อมูลเดิม"]
    scopeSubmission -->|"ใช่"| removeSubmission["ลบเฉพาะ Submission นี้และ Corrections ของมัน; คง Draft และ Submission อื่น"]
    removeSubmission --> files
    response --> check
    check -->|"ใช่"| preserveHistory["409 draft_has_history; เก็บ Draft และประวัติ; ไม่ส่ง DELETE"]
    check -->|"ไม่ใช่ หรือเป็น Admin ยืนยันลบทั้ง Response"| scopes["ตรวจ intent, owner/Draft, Operation, lease และ unknown upload"]
    scopes --> intents --> delete --> dbCommit{"initial SERIALIZABLE transaction commit หรือไม่"}
    dbCommit -->|"commit แล้ว"| files
    dbCommit -->|"verified serialization abort"| dbConflict["409 operation_in_progress; คง Response/refs; ยังไม่ dispatch DELETE"]
    dbConflict --> fresh["User Dashboard / Admin Detail ปิดกล่องเดิม โหลดข้อมูลล่าสุด ให้ผู้ใช้ตรวจและยืนยันใหม่เอง"]
    files -->|"failed / unknown"| retry
    files -->|"confirmed หรือ protected by surviving refs"| tombstone
    retry --> tombstone
    create -.-> audit
    revoke -.-> audit
    account -.-> audit
    tombstone -.-> audit
    audit --> view
